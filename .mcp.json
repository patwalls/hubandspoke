{
  "mcpServers": {
    "glitchtip": {
      "type": "http",
      "url": "https://glitchtip.walls.sh/mcp",
      "headers": {
        "Authorization": "Bearer ${GLITCHTIP_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--headless"
      ]
    }
  }
}
