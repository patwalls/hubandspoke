# Database (Heroku Postgres in prod; copy from `heroku config:get DATABASE_URL --app hubandspoke`)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Auth.js
NEXTAUTH_SECRET=  # `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000

# Notion
NOTION_API_SECRET=

# Cron
CRON_SECRET=

# Postmark (transactional email)
POSTMARK_TOKEN=
EMAIL_FROM=Hub & Spoke <pat@starterstory.com>

# ManyChat IG comment-to-DM webhook. Shared secret pasted into the
# `x-manychat-secret` header on the External Request action inside the
# "IG Comment → Hub & Spoke Lookup" automation. Generate with
# `openssl rand -hex 32`. Legacy — being replaced by the Meta direct path
# below; will be removed once the Meta webhook is verified in prod.
MANYCHAT_WEBHOOK_SECRET=

# Meta IG Graph API — direct comment-to-DM (replaces ManyChat).
# See docs/instagram-setup.md for how to obtain each value.
# - META_VERIFY_TOKEN: random string we pick; Meta echoes it back during the
#   webhook subscription handshake. `openssl rand -hex 24`.
# - META_APP_SECRET: from Meta App Dashboard → Settings → Basic. Used as the
#   HMAC key to verify inbound webhook signatures.
# - INSTAGRAM_PAGE_ACCESS_TOKEN: long-lived Page Access Token derived from
#   the FB Page linked to @starter_story. Used to send DMs.
# - INSTAGRAM_BUSINESS_ID: numeric IG Business account ID. Used to skip
#   self-comments in the webhook handler.
META_VERIFY_TOKEN=
META_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
