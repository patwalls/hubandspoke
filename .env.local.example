# Database (Heroku Postgres in prod; copy from `heroku config:get DATABASE_URL --app hubandspoke`)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Auth.js
NEXTAUTH_SECRET=  # `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000

# Notion
NOTION_API_SECRET=

# Cron
CRON_SECRET=

# Postmark (transactional email)
POSTMARK_TOKEN=
EMAIL_FROM=Hub & Spoke <pat@starterstory.com>

# Short-link redirects (go.starterstory.com). The StarterStory Rails app
# hosts the redirect service + REST API; hubandspoke is just the control
# plane. See /settings/links for the admin UI.
SHORT_LINKS_API_URL=https://www.starterstory.com/api/v1
SHORT_LINKS_API_KEY=
SHORT_LINKS_BASE_URL=https://go.starterstory.com

# Descript
# Legacy token (Pat's personal account) — used for all existing production_items where descript_account IS NULL.
DESCRIPT_API_TOKEN=
# HubSpot shared account token — used for all newly created Descript projects (descript_account = 'hubspot').
DESCRIPT_API_TOKEN_HUBSPOT=

# Typefully (auto-create drafts for new X/LinkedIn items; webhook keeps status synced)
TYPEFULLY_API_TOKEN=
TYPEFULLY_WEBHOOK_SECRET=

# E2E test user — seeded via `node --env-file=.env.local scripts/seed-user.mjs`
# Used by Playwright auth setup (see docs/conventions.md → End-to-end testing).
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=

# Cloudflare R2 (S3-compatible object storage). Consumed by src/lib/r2.ts.
# Bucket lives in the same Cloudflare account as the rest of our infra; create
# an "Object Read & Write" R2 API token scoped to the bucket in the dashboard.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=hubandspoke
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
