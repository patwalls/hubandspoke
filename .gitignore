# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.claude/scheduled_tasks.lock

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# one-shot backfill caches
.repost-llm-cache.json

# Sentry Config File
.env.sentry-build-plugin

# Playwright (e2e tests)
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
# Per-developer auth state — holds a real session cookie. Never commit.
/tests/e2e/.auth/
# Playwright MCP scratch dir (snapshots/console/page dumps from browser sessions)
/.playwright-mcp/
# Throwaway e2e specs spun up to verify a UI change when the MCP browser is down.
# See CLAUDE.md → "When the MCP session is dead". Real specs live in tests/e2e/*.spec.ts.
/tests/e2e/_scratch*.spec.ts

# autonomous ops loop artifacts (runner lock/log — see .claude/commands/go.md)
.loop.log
.loop.pid
