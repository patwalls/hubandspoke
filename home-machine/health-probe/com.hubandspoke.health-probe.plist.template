<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the home-machine production health probe.
  install.sh substitutes __HOME__ before writing this to
  ~/Library/LaunchAgents/com.hubandspoke.health-probe.plist.

  Every 5 minutes via StartInterval; RunAtLoad so a reboot re-arms it
  immediately. The script itself is idempotent and silent when green.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hubandspoke.health-probe</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/Library/Application Support/hubandspoke-health-probe/probe.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hubandspoke-health-probe.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hubandspoke-health-probe.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
