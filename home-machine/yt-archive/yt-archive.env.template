# Secrets and config for the home-machine yt-archive cron.
#
# install.sh writes this file to ~/.config/hubandspoke/yt-archive.env with
# mode 0600. Source it manually if you want to run the wrapper by hand.
#
# Required values are marked REQUIRED — install.sh prompts for each.

# REQUIRED — comma-separated brand slugs the archive should scan.
# Same shape as the `--brands=` flag for scripts/archive-yt-local.ts.
BRANDS=""

# REQUIRED — S3 bucket the production worker writes to.
# Pull from the dev .env.local of the main checkout, or from
# `heroku config:get HUBANDSPOKE_S3_BUCKET --app hubandspoke`.
HUBANDSPOKE_S3_BUCKET=""

# Optional — S3 prefix. Defaults to "hubandspoke/uploads" inside the script.
# HUBANDSPOKE_S3_PREFIX="hubandspoke/uploads"

# REQUIRED — AWS credentials that can s3:PutObject into HUBANDSPOKE_S3_BUCKET.
# Easiest path: copy the AWS_* values from the dev .env.local on the main
# checkout. Long-term: create a dedicated IAM user scoped to that bucket.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# Optional — override how many videos each hourly run downloads.
# Default 30 is friendly to YouTube. Bump if your backlog is large and you
# want the cron to chew through it faster (at the cost of bot-check risk).
# RUN_LIMIT=30

# Optional — how many days back each run should scan candidates.
# Default 2 gives ~24h of overlap between hourly runs so a missed hour
# (Mac asleep, network blip) recovers without manual intervention.
# RUN_SINCE_DAYS=2

# Optional — yt-dlp sleep window between videos. Default 2–6s is gentle.
# Set both to 0 to disable, or bump if you start seeing 429 / bot-check
# errors in the log.
# RUN_SLEEP_MIN=2
# RUN_SLEEP_MAX=6
